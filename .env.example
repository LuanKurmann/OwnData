# Secret used to sign sessions and encrypt mail credentials. Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for secure cookies)
APP_URL=http://localhost:3000

# Database (libSQL). Local file for dev/Docker, or a Turso URL for Vercel:
#   DATABASE_URL=file:./data/owndata.db
#   DATABASE_URL=libsql://owndata-<user>.turso.io  +  DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/owndata.db
DATABASE_AUTH_TOKEN=
# The Turso integration on the Vercel Marketplace sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead; both names are accepted.

# Allow new users to register. The very first user can always register (becomes admin).
ALLOW_REGISTRATION=false

# Background worker (Docker/VPS only): minutes between runs. 0 disables. Ignored on Vercel.
WORKER_INTERVAL_MINUTES=10

# Token for triggering the worker from outside: GET/POST /api/worker/run with header "x-worker-token"
WORKER_TOKEN=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/worker/run
CRON_SECRET=

# Default UI locale: de | en
DEFAULT_LOCALE=de
