# Secret used to sign sessions and encrypt mail credentials. Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used in e-mails and links)
APP_URL=http://localhost:3000

# SQLite database file. In Docker this lives on the /data volume.
DATABASE_PATH=./data/owndata.db

# Allow new users to register. The very first user can always register (becomes admin).
ALLOW_REGISTRATION=false

# Background worker: how often to send queued requests, poll the inbox and check deadlines (minutes). 0 disables.
WORKER_INTERVAL_MINUTES=10

# Optional token to trigger the worker from outside: POST /api/worker/run with header "x-worker-token"
WORKER_TOKEN=

# Default UI locale: de | en
DEFAULT_LOCALE=de
